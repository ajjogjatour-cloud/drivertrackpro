    <div class="card-gold">
      <div style="display:flex; justify-content:space-between; align-items:flex-start;">
        <div>
          <span class="badge-label">Saldo Bersih</span>
          <div id="reportNet" class="amount-large" style="font-size:1.45rem;">Rp 0</div>
        </div>
        <div style="text-align:right;">
          <span class="badge-label">Total TX</span>
          <div id="reportTxCount" style="font-size:1.4rem; font-weight:800; font-family:'DM Mono',monospace;">0</div>
