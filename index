<!-- MODAL EDIT -->
<div id="editModal" class="modal-overlay">
  <div class="modal-card">
    <div class="section-title" style="margin-bottom:14px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit Transaksi
    </div>
    <div class="select-wrap" style="margin-bottom:10px;">
      <select id="editCat" class="form-select"></select>
    </div>
    <input type="number" id="editAmount" class="form-control" placeholder="Jumlah" style="margin-bottom:10px;">
    <input type="date" id="editDate" class="form-control" style="margin-bottom:10px;">
    <input type="text" id="editNote" class="form-control" placeholder="Catatan">
    <div style="display:flex; gap:10px; margin-top:14px;">
      <button id="confirmEditBtn" class="submit-btn" style="margin:0; flex:1;">Simpan</button>
      <button id="closeModalBtn" class="icon-btn" style="padding:11px 16px;">Batal</button>
    </div>
  </div>
</div>

<script>
  // ==================== DATA ====================
  const INCOME_CATS = ["Grabcar","Gocar","Maxim","Indriver","Rent Wisata Dalam Kota","Rent Wisata Luar Kota","Lain-lain"];
  const EXPENSE_CATS = ["Sewa Mobil","Sewa Driver","Pertalite","Solar","Parkir","Biaya Toll","Makan Driver","Lain-lain"];
  const INCOME_COLORS = {"Grabcar":"#3b82f6","Gocar":"#10b981","Maxim":"#f59e0b","Indriver":"#a855f7","Rent Wisata Dalam Kota":"#f97316","Rent Wisata Luar Kota":"#ec489a","Lain-lain":"#6b7280"};
  const EXPENSE_COLORS = {"Sewa Mobil":"#ef4444","Sewa Driver":"#f97316","Pertalite":"#eab308","Solar":"#10b981","Parkir":"#3b82f6","Biaya Toll":"#8b5cf6","Makan Driver":"#ec489a","Lain-lain":"#6b7280"};

  let transactions = JSON.parse(localStorage.getItem("drivertrack_pro") || "[]");
  let monthlyTarget = parseInt(localStorage.getItem("monthlyTarget") || "0");
  let currentType = "income";
  let dashPeriod = "day", reportPeriod = "day";
  let editingId = null;
  let chartStore = {};

  const today = () => new Date().toISOString().slice(0,10);
  const getWeekKey = (d) => { let dt=new Date(d); dt.setHours(0,0,0,0); let start=new Date(dt); start.setDate(dt.getDate()-dt.getDay()+(dt.getDay()===0?-6:1)); return start.toISOString().slice(0,10); };
  const getMonthKey = (d) => d.slice(0,7);
  const getYearKey = (d) => d.slice(0,4);
  const formatIDR = (n) => new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",minimumFractionDigits:0}).format(n);
  const shortFormat = (n) => { if(n>=1e6) return `Rp ${(n/1e6).toFixed(1)}jt`; if(n>=1e3) return `Rp ${(n/1e3).toFixed(0)}rb`; return `Rp ${n}`; };
  const saveData = () => localStorage.setItem("drivertrack_pro", JSON.stringify(transactions));

  function filterByPeriod(period, refDate, arr=transactions) {
    let d = refDate || today();
    return arr.filter(t => {
      if(period==="day") return t.date===d;
      if(period==="week") return getWeekKey(t.date)===getWeekKey(d);
      if(period==="month") return getMonthKey(t.date)===(d.length===7?d:d.slice(0,7));
      if(period==="year") return getYearKey(t.date)===String(d).slice(0,4);
      return true;
    });
  }

  function buildPie(txs,type){ let m={}; txs.filter(t=>t.type===type).forEach(t=>m[t.category]=(m[t.category]||0)+t.amount); return Object.entries(m).map(([k,v])=>({name:k,value:v}));}

  function renderPie(canvasId,data,colorMap,key){
    const ctx=document.getElementById(canvasId).getContext("2d");
    if(chartStore[key])chartStore[key].destroy();
    chartStore[key]=new Chart(ctx,{
      type:"doughnut",
      data:{labels:data.map(d=>d.name),datasets:[{data:data.map(d=>d.value),backgroundColor:data.map(d=>colorMap[d.name]||"#9ca3af"),borderWidth:0}]},
      options:{plugins:{legend:{position:"bottom",labels:{color:"#8892a4",font:{size:10,family:"DM Sans"},padding:10}},tooltip:{callbacks:{label:(c)=>`${c.label}: ${shortFormat(c.raw)}`}}},cutout:"60%"}
    });
  }

  function renderMainChart(txs,period,ref){
    let labels=[], incData=[], expData=[];
    if(period==="day"){ labels=["Hari ini"]; incData=[txs.filter(t=>t.type==="income").reduce((a,b)=>a+b.amount,0)]; expData=[txs.filter(t=>t.type==="expense").reduce((a,b)=>a+b.amount,0)];}
    else if(period==="week"){ let days=["Sen","Sel","Rab","Kam","Jum","Sab","Min"],map={}; days.forEach(d=>map[d]={income:0,expense:0}); txs.forEach(t=>{let wd=new Date(t.date).getDay(),idx=wd===0?6:wd-1,lbl=days[idx];map[lbl][t.type]+=t.amount;}); labels=days; incData=days.map(d=>map[d].income); expData=days.map(d=>map[d].expense);}
    else if(period==="month"){ let dim=new Date(ref.slice(0,4),parseInt(ref.slice(5,7)),0).getDate(); let daily=Array(dim).fill().map(()=>({income:0,expense:0})); txs.forEach(t=>{let d=parseInt(t.date.slice(8))-1;if(d>=0&&d<dim)daily[d][t.type]+=t.amount;}); labels=Array.from({length:dim},(_,i)=>i+1); incData=daily.map(d=>d.income); expData=daily.map(d=>d.expense);}
    else{ let months=["Jan","Feb","Mar","Apr","Mei","Jun","Jul","Agu","Sep","Okt","Nov","Des"],arr=Array(12).fill().map(()=>({income:0,expense:0})); txs.forEach(t=>{let m=parseInt(t.date.slice(5,7))-1;if(m>=0&&m<12)arr[m][t.type]+=t.amount;}); labels=months; incData=arr.map(m=>m.income); expData=arr.map(m=>m.expense);}
    const ctx=document.getElementById("mainChartCanvas").getContext("2d");
    if(chartStore.main)chartStore.main.destroy();
    chartStore.main=new Chart(ctx,{type:"bar",data:{labels,datasets:[{label:"Pendapatan",data:incData,backgroundColor:"rgba(34,212,122,0.5)",borderRadius:6},{label:"Pengeluaran",data:expData,backgroundColor:"rgba(255,95,95,0.5)",borderRadius:6}]},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{labels:{color:"#8892a4",font:{size:10,family:"DM Sans"}}},tooltip:{callbacks:{label:(ctx)=>` ${ctx.dataset.label}: ${shortFormat(ctx.raw)}`}}},scales:{y:{ticks:{callback:v=>shortFormat(v),color:"#4d5a70",font:{size:10}},grid:{color:"rgba(255,255,255,0.04)"}},x:{ticks:{color:"#4d5a70",font:{size:10}},grid:{display:false}}}}});
  }

  function renderDashboard() {
    let base = document.getElementById("dashDate").value || today();
    let filtered = filterByPeriod(dashPeriod, base);
    let inc = filtered.filter(t=>t.type==="income").reduce((s,a)=>s+a.amount,0);
    let exp = filtered.filter(t=>t.type==="expense").reduce((s,a)=>s+a.amount,0);
    let net = inc - exp;
    document.getElementById("dashIncome").innerHTML = shortFormat(inc);
    document.getElementById("dashExpense").innerHTML = shortFormat(exp);
    let netEl = document.getElementById("dashNet");
    netEl.innerHTML = net<0 ? `- ${shortFormat(Math.abs(net))}` : shortFormat(net);
    netEl.style.color = net>=0 ? "var(--accent)" : "var(--danger)";
    document.getElementById("netHint").innerHTML = net>=0 ? "✨ Sehat! Terus semangat, Kamu harus bisa" : "⚠️ Defisit, periksa pengeluaran";

    let currentMonth = getMonthKey(base);
    let monthIncome = transactions.filter(t=>t.type==="income" && getMonthKey(t.date)===currentMonth).reduce((s,a)=>s+a.amount,0);
    let percent = monthlyTarget>0 ? Math.min(100, (monthIncome/monthlyTarget)*100) : 0;
    document.getElementById("targetProgressArea").innerHTML = `
      <div class="target-progress">
        <div class="progress-row"><span>${shortFormat(monthIncome)}</span><span>Target: ${shortFormat(monthlyTarget)}</span></div>
        <div class="progress-bar-bg"><div class="progress-fill" style="width:${percent}%;"></div></div>
        <div style="font-size:0.67rem; color:var(--text-muted); font-weight:600;">${percent.toFixed(0)}% tercapai</div>
      </div>
    `;
    let hasData = filtered.length>0;
    document.getElementById("dashEmptyMsg").style.display = hasData?"none":"block";
    document.getElementById("chartCard").style.display = hasData?"block":"none";
    if(hasData) renderMainChart(filtered, dashPeriod, base);
    let pieInc = buildPie(filtered,"income"), pieExp = buildPie(filtered,"expense");
    document.getElementById("pieIncomeCard").style.display = pieInc.length?"block":"none";
    document.getElementById("pieExpenseCard").style.display = pieExp.length?"block":"none";
    if(pieInc.length) renderPie("pieIncomeCanvas", pieInc, INCOME_COLORS, "pieInc");
    if(pieExp.length) renderPie("pieExpenseCanvas", pieExp, EXPENSE_COLORS, "pieExp");
  }

  function renderLaporan() {
    let base = document.getElementById("reportDate").value || today();
    let filtered = filterByPeriod(reportPeriod, base);
    let inc = filtered.filter(t=>t.type==="income").reduce((s,a)=>s+a.amount,0);
    let exp = filtered.filter(t=>t.type==="expense").reduce((s,a)=>s+a.amount,0);
    let net = inc-exp;
    document.getElementById("reportIncomeSum").innerHTML = formatIDR(inc);
    document.getElementById("reportExpenseSum").innerHTML = formatIDR(exp);
    document.getElementById("reportNet").innerHTML = net<0?`- ${formatIDR(Math.abs(net))}`:formatIDR(net);
    document.getElementById("reportTxCount").innerText = filtered.length;
    let hasData = filtered.length>0;
    document.getElementById("breakdownCard").style.display = hasData?"block":"none";
    if(hasData){
      let incB="",expB="";
      INCOME_CATS.forEach(c=>{let amt=filtered.filter(t=>t.type==="income"&&t.category===c).reduce((s,a)=>s+a.amount,0); if(amt>0&&inc>0){let pct=(amt/inc)*100; incB+=`<div class="cat-progress"><div class="cat-header"><span>${c}</span><span>${shortFormat(amt)} &nbsp;${pct.toFixed(0)}%</span></div><div class="progress-bar-bg"><div class="progress-fill" style="width:${pct}%;background:${INCOME_COLORS[c]||"#f59e0b"}"></div></div></div>`;}});
      EXPENSE_CATS.forEach(c=>{let amt=filtered.filter(t=>t.type==="expense"&&t.category===c).reduce((s,a)=>s+a.amount,0); if(amt>0&&exp>0){let pct=(amt/exp)*100; expB+=`<div class="cat-progress"><div class="cat-header"><span>${c}</span><span>${shortFormat(amt)} &nbsp;${pct.toFixed(0)}%</span></div><div class="progress-bar-bg"><div class="progress-fill" style="width:${pct}%;background:${EXPENSE_COLORS[c]||"#f87171"}"></div></div></div>`;}});
      document.getElementById("breakdownIncomeArea").innerHTML = incB?`<div class="section-title" style="font-size:0.68rem; margin-bottom:8px;">Pendapatan</div>${incB}`:"<div style='font-size:0.78rem;color:var(--text-muted)'>Tidak ada pendapatan</div>";
      document.getElementById("breakdownExpenseArea").innerHTML = expB?`<div class="section-title" style="font-size:0.68rem; margin-bottom:8px;">Pengeluaran</div>${expB}`:"";
    }
    let sorted=[...filtered].sort((a,b)=>new Date(b.date)-new Date(a.date));
    let listDiv=document.getElementById("txListDynamic");
    if(sorted.length===0){listDiv.innerHTML="<div class='empty-state'>Belum ada transaksi</div>";return;}
    listDiv.innerHTML=sorted.map(tx=>`
      <div class="tx-item">
        <div class="tx-info">
          <div class="tx-dot" style="background:${tx.type==="income"?INCOME_COLORS[tx.category]||"#22d47a":EXPENSE_COLORS[tx.category]||"#ff5f5f"}"></div>
          <div>
            <div class="tx-cat">${tx.category}</div>
            <div class="tx-date">${tx.date}${tx.note?` · ${tx.note}`:""}</div>
          </div>
        </div>
        <div class="action-btns">
          <span class="tx-amount ${tx.type}">${tx.type==="income"?"+":"-"} ${shortFormat(tx.amount)}</span>
          <button class="edit-btn" data-id="${tx.id}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </button>
          <button class="del-btn" data-id="${tx.id}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
          </button>
        </div>
      </div>
    `).join("");
    document.querySelectorAll(".edit-btn").forEach(btn=>btn.addEventListener("click",()=>{let id=parseInt(btn.dataset.id); let tx=transactions.find(t=>t.id===id); if(tx)openEditModal(tx);}));
    document.querySelectorAll(".del-btn").forEach(btn=>btn.addEventListener("click",()=>deleteTx(parseInt(btn.dataset.id))));
  }

  function openEditModal(tx){
    editingId=tx.id;
    let cats=tx.type==="income"?INCOME_CATS:EXPENSE_CATS;
    document.getElementById("editCat").innerHTML=cats.map(c=>`<option ${c===tx.category?"selected":""}>${c}</option>`).join("");
    document.getElementById("editAmount").value=tx.amount;
    document.getElementById("editDate").value=tx.date;
    document.getElementById("editNote").value=tx.note||"";
    document.getElementById("editModal").classList.add("active");
  }

  function saveEdit(){
    let idx=transactions.findIndex(t=>t.id===editingId);
    if(idx===-1)return;
    let type=transactions[idx].type;
    transactions[idx]={id:editingId,type,category:document.getElementById("editCat").value,amount:parseFloat(document.getElementById("editAmount").value),note:document.getElementById("editNote").value,date:document.getElementById("editDate").value};
    saveData(); showToast("Transaksi diperbarui"); closeModal(); renderDashboard(); renderLaporan(); updateTodaySummary();
  }

  function closeModal(){ document.getElementById("editModal").classList.remove("active"); editingId=null; }
  function deleteTx(id){ if(confirm("Hapus transaksi?")){ transactions=transactions.filter(t=>t.id!==id); saveData(); showToast("Terhapus"); renderDashboard(); renderLaporan(); updateTodaySummary(); } }
  function showToast(msg){ let t=document.createElement("div"); t.className="toast-msg"; t.innerText=msg; document.body.appendChild(t); setTimeout(()=>t.remove(),2200); }

  function exportToJPEG(){
    const element=document.querySelector("#dashboardPane");
    html2canvas(element,{scale:2,backgroundColor:getComputedStyle(document.body).getPropertyValue('--bg-primary')}).then(canvas=>{
      let link=document.createElement("a"); link.download="drivertrack_dashboard.jpeg"; link.href=canvas.toDataURL("image/jpeg",0.9); link.click(); showToast("Dashboard tersimpan sebagai JPEG");
    }).catch(()=>showToast("Gagal export"));
  }

  function setTarget(){
    let val=parseFloat(document.getElementById("targetAmount").value);
    if(!isNaN(val)&&val>0){ monthlyTarget=val; localStorage.setItem("monthlyTarget",val); showToast("Target bulanan disimpan"); renderDashboard(); }
    else showToast("Masukkan nominal valid");
  }

  function toggleTheme(){
    document.body.classList.toggle("light");
    localStorage.setItem("theme",document.body.classList.contains("light")?"light":"dark");
    showToast(document.body.classList.contains("light")?"Mode Terang":"Mode Gelap");
    renderDashboard(); renderLaporan();
  }

  function applySavedTheme(){
    let saved=localStorage.getItem("theme");
    if(saved==="light") document.body.classList.add("light");
    else document.body.classList.remove("light");
  }

  function populateCat(){ document.getElementById("catSelect").innerHTML=(currentType==="income"?INCOME_CATS:EXPENSE_CATS).map(c=>`<option>${c}</option>`).join("");}

  function updateTodaySummary(){
    let todayTx=transactions.filter(t=>t.date===today());
    let inc=todayTx.filter(t=>t.type==="income").reduce((s,a)=>s+a.amount,0);
    let exp=todayTx.filter(t=>t.type==="expense").reduce((s,a)=>s+a.amount,0);
    document.getElementById("todayInc").innerHTML=shortFormat(inc);
    document.getElementById("todayExp").innerHTML=shortFormat(exp);
  }

  function submitTx(){
    let amt=parseFloat(document.getElementById("txAmount").value);
    if(isNaN(amt)||amt<=0){showToast("Jumlah tidak valid");return;}
    let newTx={id:Date.now(),type:currentType,category:document.getElementById("catSelect").value,amount:amt,note:document.getElementById("txNote").value,date:document.getElementById("txDate").value||today()};
    transactions.unshift(newTx); saveData();
    document.getElementById("txAmount").value=""; document.getElementById("txNote").value="";
    document.getElementById("amtPreview").innerHTML="";
    showToast(`${currentType==="income"?"Pendapatan":"Pengeluaran"} ditambahkan`);
    updateTodaySummary(); renderDashboard(); renderLaporan();
  }

  // ==================== EVENTS ====================
  function bindEvents() {
    document.getElementById("themeToggleBtn").onclick = toggleTheme;
    document.getElementById("exportJpegBtn").onclick = exportToJPEG;
    document.getElementById("setTargetBtn").onclick = setTarget;
    document.getElementById("saveTxBtn").onclick = submitTx;
    document.getElementById("confirmEditBtn").onclick = saveEdit;
    document.getElementById("closeModalBtn").onclick = closeModal;

    document.querySelectorAll("[data-period]").forEach(btn=>{
      btn.onclick = () => {
        dashPeriod = btn.dataset.period;
        document.querySelectorAll("[data-period]").forEach(b=>b.classList.remove("active"));
        btn.classList.add("active");
        let di = document.getElementById("dashDate");
        if(dashPeriod==="month") di.type="month";
        else if(dashPeriod==="year") di.type="number";
        else di.type="date";
        renderDashboard();
      };
    });

    document.querySelectorAll("[data-rperiod]").forEach(btn=>{
      btn.onclick = () => {
        reportPeriod = btn.dataset.rperiod;
        document.querySelectorAll("[data-rperiod]").forEach(b=>b.classList.remove("active"));
        btn.classList.add("active");
        let inp = document.getElementById("reportDate");
        if(reportPeriod==="month") inp.type="month";
        else if(reportPeriod==="year") inp.type="number";
        else inp.type="date";
        renderLaporan();
      };
    });

    document.getElementById("dashDate").onchange = renderDashboard;
    document.getElementById("reportDate").onchange = renderLaporan;

    document.querySelectorAll("#typeToggle .toggle-btn").forEach(btn=>{
      btn.onclick = () => {
        currentType = btn.dataset.type;
        document.querySelectorAll("#typeToggle .toggle-btn").forEach(b=>b.classList.remove("income-active","expense-active"));
        if(currentType==="income") btn.classList.add("income-active");
        else btn.classList.add("expense-active");
        populateCat();
        document.getElementById("saveTxBtn").innerHTML = currentType==="income"?"+ Simpan Pendapatan":"+ Simpan Pengeluaran";
      };
    });

    document.getElementById("txAmount").oninput = () => {
      let v = parseFloat(document.getElementById("txAmount").value);
      document.getElementById("amtPreview").innerHTML = v>0?formatIDR(v):"";
    };

    document.querySelectorAll(".nav-tab").forEach(btn=>{
      btn.onclick = () => {
        let tab = btn.dataset.nav;
        document.querySelectorAll(".tab-pane").forEach(p=>p.classList.remove("active"));
        document.getElementById(`${tab}Pane`).classList.add("active");
        document.querySelectorAll(".nav-tab").forEach(b=>b.classList.remove("active"));
        btn.classList.add("active");
        if(tab==="dashboard") renderDashboard();
        if(tab==="catat"){ updateTodaySummary(); populateCat(); }
        if(tab==="laporan") renderLaporan();
      };
    });
  }

  // ==================== INIT ====================
  document.getElementById("dashDate").value = today();
  document.getElementById("reportDate").value = today();
  document.getElementById("txDate").value = today();
  document.getElementById("targetAmount").value = monthlyTarget || "";
  populateCat();
  updateTodaySummary();
  renderDashboard();
  renderLaporan();
  applySavedTheme();
  bindEvents();
</script>
</body>
</html>
